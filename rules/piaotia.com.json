{
  "domain": "piaotia.com",
  "url_pattern": "piaotia\\.com/bookinfo/",
  "parser_type": "generic",
  "selectors": {
    "title": "h1",
    "author": "td[width='25%']:nth-of-type(2)|after:者：|trim",
    "cover": "a[href*='/files/article/image/'] img@src",
    "desc": "td[width='80%'] div[style*='float']|regex:内容简介：(?:</span>)?([\\s\\S]+)",
    "status": "table[cellpadding='3']|regex:文章状态：(\\S+)",
    "genres": "td[width='25%']:nth-of-type(1):not(.odd)|after:别：|trim",
    "toc": {
      "list_container": "div.centent",
      "item": "div.centent ul li a",
      "total_page": "",
      "next_page": "",
      "page_url_pattern": "",
      "toc_url": "caption > a"
    },
    "chapter": {
      "content": "body",
      "remove": [
        "h1",
        ".toplink",
        ".bottomlink",
        "table",
        "#guild",
        "#shop",
        "#Commenddiv",
        "#feit2",
        "script",
        "style"
      ]
    }
  },
  "config": {
    "pagination_mode": "single_page_ajax",
    "rate_limit_ms": 1000
  },
  "version": "1.0.1",
  "author": "WebBound",
  "language": "zh",
  "description": "piaotia.com — Chinese web novels (飘天文学)."
}
