{
  "domain": "piaotia.com",
  "url_pattern": "piaotia\\.com/bookinfo/",
  "parser_type": "generic",
  "selectors": {
    "title": "h1",
    "author": "tr:nth-of-type(2) td:nth-of-type(2)|after:者：|trim",
    "cover": "img[src*='/files/article/image/']@src",
    "desc": "td[width='80%'] tr:last-child td|after:內容簡介：|trim",
    "status": "tr:nth-of-type(3) td:nth-of-type(2)|after:文章状态：|trim",
    "genres": "tr:nth-of-type(2) td:nth-of-type(1)|after:别：|trim",
    "toc": {
      "list_container": "div.centent",
      "item": "div.centent ul li a",
      "total_page": "",
      "next_page": "",
      "page_url_pattern": "",
      "toc_url": "caption > a"
    },
    "chapter": {
      "content": "body",
      "remove": [
        "h1",
        ".toplink",
        "table",
        "#guild",
        "#shop",
        "#Commenddiv",
        "#feit2",
        "script",
        "style"
      ]
    }
  },
  "config": {
    "pagination_mode": "single_page_ajax",
    "rate_limit_ms": 1000
  },
  "version": "1.0.0",
  "author": "WebBound",
  "language": "zh",
  "description": "piaotia.com — Chinese web novels (飘天文学).",
  "marketplace": {
    "name": "Piaotia",
    "icon": "📕",
    "featured": true,
    "description": "Piaotia (piaotia.com) — Chinese web novels."
  }
}
