{
  "domain": "novel543.com",
  "parser_type": "scriptable",
  "selectors": {
    "title": ".media-content.info > .title",
    "author": "#detail > div.media > div.media-content.info > p.meta span.author",
    "cover": ".cover.full img",
    "desc": ".intro.is-hidden-mobile",
    "status": "",
    "genres": "p.meta > span > a",
    "toc": {
      "list_container": "",
      "item": "ul.one.two-700.three-900.all > li a",
      "total_page": "",
      "next_page": "",
      "page_url_pattern": "",
      "toc_url": ".chaplist div.more > a:nth-of-type(1)"
    },
    "chapter": {
      "content": ".chapter-content .content",
      "remove": [
        ".gadBlock",
        ".adBlock"
      ]
    }
  },
  "config": {
    "pagination_mode": "multi_page",
    "rate_limit_ms": 1000
  },
  "version": "1.1.0",
  "author": "WebBound",
  "language": "zh",
  "description": "novel543.com (Cloudflare-protected). Requires Force Hybrid Mode: book page -> /dir TOC -> chapters. extractMetadata re-fetches the real page via ctx.fetch (hybrid) because fetchMetadata uses plain fetch.",
  "marketplace": {
    "name": "Novel543",
    "icon": "📕",
    "featured": true,
    "description": "Novel543 (novel543.com) — Chinese web novels. Requires Force Hybrid Mode (Cloudflare)."
  }
}
